// Generated by tools/gen_number_cases.py from CPython. DO NOT EDIT.
//
// Every numeric literal the tokenizer must read and the value CPython gives
// it: an integer as its decimal string, a float as its 64-bit pattern (exact,
// and independent of anyone's `repr`), a refused literal as `Refused`.

///|
priv enum Expect {
  WantInt(String)
  WantFloat(UInt64)
  WantImaginary(UInt64)
  Refused
}

///|
let cases : Array[(String, Expect)] = [
  ("0", WantInt("0")),
  ("00", WantInt("0")),
  ("000", WantInt("0")),
  ("1", WantInt("1")),
  ("7", WantInt("7")),
  ("42", WantInt("42")),
  ("1_000", WantInt("1000")),
  ("1_000_000", WantInt("1000000")),
  (
    "1000000000000000000000000000000000000000",
    WantInt("1000000000000000000000000000000000000000"),
  ),
  ("0x0", WantInt("0")),
  ("0xff", WantInt("255")),
  ("0xFF", WantInt("255")),
  ("0XfF", WantInt("255")),
  ("0x_ff", WantInt("255")),
  ("0x_FF_ff", WantInt("65535")),
  ("0xdead_beef", WantInt("3735928559")),
  ("0o0", WantInt("0")),
  ("0o17", WantInt("15")),
  ("0O17", WantInt("15")),
  ("0o_17", WantInt("15")),
  ("0o777", WantInt("511")),
  ("0b0", WantInt("0")),
  ("0b1", WantInt("1")),
  ("0b1_0", WantInt("2")),
  ("0B1010", WantInt("10")),
  ("0b_1_0", WantInt("2")),
  ("0.0", WantFloat(0x0000000000000000UL)),
  ("1.0", WantFloat(0x3FF0000000000000UL)),
  ("1.", WantFloat(0x3FF0000000000000UL)),
  (".5", WantFloat(0x3FE0000000000000UL)),
  ("0.5", WantFloat(0x3FE0000000000000UL)),
  ("1.5", WantFloat(0x3FF8000000000000UL)),
  ("3.14159", WantFloat(0x400921F9F01B866EUL)),
  ("1e10", WantFloat(0x4202A05F20000000UL)),
  ("1E10", WantFloat(0x4202A05F20000000UL)),
  ("1e+10", WantFloat(0x4202A05F20000000UL)),
  ("1e-10", WantFloat(0x3DDB7CDFD9D7BDBBUL)),
  ("1.5e3", WantFloat(0x4097700000000000UL)),
  ("1.e3", WantFloat(0x408F400000000000UL)),
  (".5e3", WantFloat(0x407F400000000000UL)),
  ("1_0.0_1e-1_0", WantFloat(0x3E113271CE87220FUL)),
  ("1e308", WantFloat(0x7FE1CCF385EBC8A0UL)),
  ("1e-308", WantFloat(0x000730D67819E8D2UL)),
  ("5e-324", WantFloat(0x0000000000000001UL)),
  ("1.7976931348623157e308", WantFloat(0x7FEFFFFFFFFFFFFFUL)),
  ("0.1", WantFloat(0x3FB999999999999AUL)),
  ("0.2", WantFloat(0x3FC999999999999AUL)),
  ("0.3", WantFloat(0x3FD3333333333333UL)),
  ("100.0", WantFloat(0x4059000000000000UL)),
  ("1e16", WantFloat(0x4341C37937E08000UL)),
  ("1e15", WantFloat(0x430C6BF526340000UL)),
  ("1j", WantImaginary(0x3FF0000000000000UL)),
  ("1.5j", WantImaginary(0x3FF8000000000000UL)),
  ("0j", WantImaginary(0x0000000000000000UL)),
  ("3J", WantImaginary(0x4008000000000000UL)),
  ("1e10j", WantImaginary(0x4202A05F20000000UL)),
  ("1__0", Refused),
  ("0_", Refused),
  ("09", Refused),
  ("01", Refused),
  ("0_1", Refused),
]

///|
test "every numeric literal reads as CPython reads it" {
  for case in cases {
    let (lit, want) = case
    let source = "x = " + lit + "\n"
    let got = try {
      let tokens = @lexer.lex_string(source)
      Some(tokens[2].number_value())
    } catch {
      _ => None
    }
    match (want, got) {
      (Refused, None) => ()
      (Refused, Some(_)) => fail("\{lit}: CPython refuses it and we did not")
      (_, None) => fail("\{lit}: we refused it and CPython does not")
      (WantInt(text), Some(Int(n))) => assert_eq(n.to_string(), text, msg=lit)
      (WantFloat(bits), Some(Float(d))) =>
        assert_eq(d.reinterpret_as_uint64(), bits, msg=lit)
      (WantImaginary(bits), Some(Imaginary(d))) =>
        assert_eq(d.reinterpret_as_uint64(), bits, msg=lit)
      (_, Some(_)) => fail("\{lit}: the wrong kind of number")
    }
  }
}
