// Generated by tools/gen_string_cases.py from CPython. DO NOT EDIT.
//
// Every string and bytes literal whose decoding could go wrong, and the value
// CPython gives it -- as code points, so the table depends on no one's `repr`.

///|
priv enum Want {
  WantStr(Array[Int])
  WantBytes(Array[Int])
  Refused
}

///|
let string_cases : Array[(String, Want)] = [
  ("\"\"", WantStr([])),
  ("''", WantStr([])),
  ("\"a\"", WantStr([97])),
  ("'a'", WantStr([97])),
  ("\"ab c\"", WantStr([97, 98, 32, 99])),
  ("\"it's\"", WantStr([105, 116, 39, 115])),
  ("'say \"hi\"'", WantStr([115, 97, 121, 32, 34, 104, 105, 34])),
  ("\"\\n\"", WantStr([10])),
  ("\"\\t\"", WantStr([9])),
  ("\"\\r\"", WantStr([13])),
  ("\"\\\\\"", WantStr([92])),
  ("\"\\'\"", WantStr([39])),
  ("\"\\\"\"", WantStr([34])),
  ("\"\\a\"", WantStr([7])),
  ("\"\\b\"", WantStr([8])),
  ("\"\\f\"", WantStr([12])),
  ("\"\\v\"", WantStr([11])),
  ("\"\\0\"", WantStr([0])),
  ("\"\\7\"", WantStr([7])),
  ("\"\\10\"", WantStr([8])),
  ("\"\\101\"", WantStr([65])),
  ("\"\\377\"", WantStr([255])),
  ("\"\\x41\"", WantStr([65])),
  ("\"\\x00\"", WantStr([0])),
  ("\"\\xff\"", WantStr([255])),
  ("\"é\"", WantStr([233])),
  ("\"€\"", WantStr([8364])),
  ("\"\\U0001F40D\"", WantStr([128013])),
  ("\"\\N{BULLET}\"", WantStr([8226])),
  ("\"\\d\"", WantStr([92, 100])),
  ("\"\\q\\w\"", WantStr([92, 113, 92, 119])),
  ("\"a\\\n b\"", WantStr([97, 32, 98])),
  ("r\"\\n\"", WantStr([92, 110])),
  ("r\"\\\\\"", WantStr([92, 92])),
  ("R\"a\\\"b\"", WantStr([97, 92, 34, 98])),
  ("r\"\\x41\"", WantStr([92, 120, 52, 49])),
  ("u\"x\"", WantStr([120])),
  ("U\"x\"", WantStr([120])),
  ("b\"x\"", WantBytes([120])),
  ("B\"x\"", WantBytes([120])),
  ("rb\"\\x41\"", WantBytes([92, 120, 52, 49])),
  ("bR\"\\n\"", WantBytes([92, 110])),
  ("Br\"\\n\"", WantBytes([92, 110])),
  ("RB\"\\n\"", WantBytes([92, 110])),
  ("\"\"\"a\"\"\"", WantStr([97])),
  ("'''a'''", WantStr([97])),
  ("\"\"\"a\nb\"\"\"", WantStr([97, 10, 98])),
  ("\"\"\"say \"hi\"\"\"\"", Refused),
  ("\"\"\"\"\"\"", WantStr([])),
  ("\"héllo\"", WantStr([104, 233, 108, 108, 111])),
  ("\"🐍\"", WantStr([128013])),
  ("\"日本語\"", WantStr([26085, 26412, 35486])),
]

///|
test "every string literal decodes as CPython decodes it" {
  for case in string_cases {
    let (lit, want) = case
    let source = "x = " + lit + "\n"
    let got = try {
      let tokens = @lexer.lex_string(source)
      let t = tokens[2]
      if t.kind is Bytes(_) {
        Some(("bytes", t.bytes_value().to_array().map(fn(b) { b.to_int() })))
      } else {
        Some(("str", t.str_value().to_array().map(fn(c) { c.to_int() })))
      }
    } catch {
      _ => None
    }
    match (want, got) {
      (Refused, None) => ()
      (Refused, Some(_)) => fail("\{lit}: CPython refuses it and we did not")
      (_, None) => fail("\{lit}: we refused it and CPython does not")
      (WantStr(points), Some(("str", got_points))) =>
        assert_eq(got_points, points, msg=lit)
      (WantBytes(points), Some(("bytes", got_points))) =>
        assert_eq(got_points, points, msg=lit)
      (_, Some(_)) =>
        fail("\{lit}: str where bytes were wanted, or the reverse")
    }
  }
}
