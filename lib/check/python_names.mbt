///|
/// The members of a predefined module, by its name, as `hasattr` sees them.
fn python_module_members(m : String) -> Array[String]? {
  match m {
    "sys" => Some(python_members_sys)
    "typing" => Some(python_members_typing)
    "dataclasses" => Some(python_members_dataclasses)
    _ => None
  }
}

///|
/// The attributes of a built-in type, by its Python class name.
fn python_type_attrs(t : String) -> Array[String]? {
  match t {
    "list" => Some(python_attrs_list)
    "dict" => Some(python_attrs_dict)
    "tuple" => Some(python_attrs_tuple)
    "bool" => Some(python_attrs_bool)
    "int" => Some(python_attrs_int)
    "float" => Some(python_attrs_float)
    "str" => Some(python_attrs_str)
    _ => None
  }
}
