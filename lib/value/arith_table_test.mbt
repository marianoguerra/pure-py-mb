///|
let undefined_cases : Array[String] = [
  // string formatting; CPython says '3'
  "\"%d\" % 3",
  // string formatting; CPython says 'a'
   "\"a\" % []",
  // bool is not a count; CPython says 'a'
   "\"a\" * True",
  // unrelated kinds; CPython says False
   "\"a\" == 1",
  // string formatting; CPython says 'a-b'
   "\"a-%s\" % \"b\"",
  // bool is not a number; CPython says 0
   "+False",
  // bool is not a number; CPython says -1
   "-True",
  // bool is not a number; CPython says !ZeroDivisionError
   "1 % False",
  // unrelated kinds; CPython says !TypeError
   "1 < 'a'",
  // unrelated kinds; CPython says False
   "1 == \"a\"",
  // bool against int; CPython says True
   "1 == True",
  // membership in a number; CPython says !TypeError
   "1 in 2",
  // bool is not a number; CPython says 2
   "True * 2",
  // bool is not a number; CPython says 2
   "True + 1",
  // bool is not a number; CPython says True
   "True < 2",
  // bool against int; CPython says True
   "True == 1",
  // eq reaches an undefined pair; CPython says False
   "[1, \"a\"] == [1, 3]",
  // a list against a tuple; CPython says !TypeError
   "[1] < (1,)",
  // a list against a tuple; CPython says False
   "[1] == (1,)",
  // truthiness; CPython says False
   "not 1",
  // truthiness; CPython says True
   "not None",
  // a dict key that is not a string; CPython says {1: 2}
   "{1: 2}",
]

///|
let type_error_cases : Array[String] = []

///|
test "every operator over literals answers as CPython answers" {
  for case in arith_cases {
    let (expr, want) = case
    assert_eq(evaluate(expr), want, msg=expr)
  }
}

///|
test "the operations PurePy leaves undefined" {
  for expr in undefined_cases {
    assert_eq(evaluate(expr), "!stuck", msg=expr)
  }
}

///|
test "the operations PurePy aborts where Python has an answer" {
  for expr in type_error_cases {
    assert_eq(evaluate(expr), "!TypeError", msg=expr)
  }
}
