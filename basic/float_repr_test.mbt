///|
test "every float prints the way CPython prints it" {
  for case in float_cases {
    let (bits, want) = case
    let d = bits.reinterpret_as_double()
    assert_eq(@basic.py_float_repr(d), want, msg="bits 0x\{bits}")
  }
}
